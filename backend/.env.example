# Copy to backend/.env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Reverse proxies allowed to set X-Forwarded-For (nginx on the same server)
TRUST_PROXY=127.0.0.1,::1
LOG_LEVEL=info

# Public origin of the web app (used for CORS/Origin checks, links in emails)
APP_ORIGIN=http://localhost:3000
# Public origin of this API as seen by devices and browsers (used for OTA download URLs)
API_ORIGIN=http://localhost:4000

DATABASE_URL=postgres://voltix:voltix_dev@localhost:5433/voltix

# 32+ random characters each. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me-dev-only-jwt-secret-0123456789
# Exactly 32 bytes, base64. Encrypts controller secrets at rest.
SECRET_ENC_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=

# Set true in production (Secure cookies; requires HTTPS)
COOKIE_SECURE=false
REQUIRE_EMAIL_VERIFICATION=false

# Mail (dev: Mailpit from docker compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Voltix <no-reply@voltix.local>"

# Web push (VAPID). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@voltix.local

# Where uploaded firmware binaries are stored
STORAGE_DIR=./storage

# First platform admin (created by db:seed if missing)
ADMIN_EMAIL=admin@voltix.local
ADMIN_PASSWORD=change-me-admin-password
