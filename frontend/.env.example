# Where `next dev` / `next start` forwards /api requests (the Voltix backend).
API_PROXY_TARGET=http://localhost:4000

# Realtime socket. Leave empty in production when the app and /api share one domain.
# In development the socket goes straight to the backend (Next's proxy does not forward WebSockets).
NEXT_PUBLIC_WS_URL=ws://localhost:4000/api/v1/ws
